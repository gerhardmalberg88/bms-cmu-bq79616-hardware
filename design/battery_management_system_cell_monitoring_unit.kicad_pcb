				)
			)
		)
		(property "Datasheet" ""
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "a10f2de6-d94d-440a-a77e-0ed6c9d40999")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Description" "RES 20R 1% 2W 1225 wide-term thick film AEC-Q200 - CB balance current set Fitted on the original Vishay land (1.60 x 6.60mm pads on a 1.20mm gap, 4.40mm span) rather than KiCad R_1225_3264Metric, which is a generic IPC-7351 1225 with 21% less pad area and no 3D model. RCL is a long-side termination part, so the terminations run along the 6.3mm side and the pad copper is the conduction path the 2W rating depends on - see docs CMU-002 section 8 and CMU-005 section 2."
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
