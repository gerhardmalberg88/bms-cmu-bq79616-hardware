	(footprint "custom_footprints:Vishay_RCL1225_2W_3.2x6.3mm"
		(layer "F.Cu")
		(uuid "2cdf57c7-e435-434d-986f-57ad9a8ca872")
		(at 251.2 122.3 -90)
		(descr "Vishay RCL1225 e3 long-side-termination thick film chip resistor, 2W, 3.2 x 6.3 x 0.70mm. Reverse geometry - the terminations run along the 6.3mm side, which is what allows 2W in this size. Manufacturer reflow land: 1.60 x 6.60mm pads on a 1.20mm gap, 4.40mm span. This is NOT KiCad's R_1225_3264Metric, which is a generic IPC-7351 1225 with 21% less pad area and no 3D model; for a part rated on conduction through its terminations the manufacturer land is the one the rating assumes. Series land pattern - the value is set by the order number, e.g. RCL122520R0FKEG for 20R 1%")
		(tags "vishay rcl1225 resistor 2w reverse geometry long side termination original datasheet")
		(property "Reference" "R334"
			(at 0 -4.2 90)
			(layer "F.SilkS")
			(hide yes)
			(uuid "8958a23c-87fd-4718-8f13-4d3e1c253b32")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Value" "20R 2W"
			(at 0 4.2 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "0a468391-ef12-4a20-b1ca-4430096b0ffa")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Datasheet" ""
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "f4e87561-d95a-46a6-b80a-e169721c1395")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(property "Description" "RES 20R 1% 2W 1225 wide-term thick film AEC-Q200 - CB balance current set Fitted on the original Vishay land (1.60 x 6.60mm pads on a 1.20mm gap, 4.40mm span) rather than KiCad R_1225_3264Metric, which is a generic IPC-7351 1225 with 21% less pad area and no 3D model. RCL is a long-side termination part, so the terminations run along the 6.3mm side and the pad copper is the conduction path the 2W rating depends on - see docs CMU-002 section 8 and CMU-005 section 2."
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "fba2dc09-0a69-40d4-b650-44fd24f862d1")
