					(thickness 0.15)
				)
			)
		)
		(property "Value" "500mA 125V FF"
			(at 0 2.3 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "33c1aa67-46b3-4d13-b388-b8bb96215858")
			(effects
