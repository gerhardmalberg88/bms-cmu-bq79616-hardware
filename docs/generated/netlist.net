		(comp
			(ref "F601")
			(value "500mA 125V FF")
			(footprint "custom_footprints:Littelfuse_470-Series_Fuse_1206")
			(datasheet "https://www.littelfuse.com/products/fuses-overcurrent-protection/fuses/surface-mount-fuses/thin-film-chip-fuses/470")
			(description "FUSE 500mA 125VAC/125VDC fast acting, Littelfuse 470 Series thin-film chip fuse 1206, 0.5455 Ohm cold resistance, 0.0287 A2s nominal melting I2t, interrupting 50A at 125VDC, -55 to +125C, epoxy resin body with Cu/Ni/Sn terminations, Pb-free and halogen-free - 8V8 rail fuse, same part as the 51 cell tap fuses. Carries only the BQ79616 LDOIN supply: 11.6mA IACT(IDLE) max, about 25mA with daisy-chain broadcast, ADC, balancing and open-wire test all active, 20mA startup inrush - 5% of nameplate, so no wear-out concern. Drops 14mV at 25mA against the 800mV budget between the 8.80V rail and the 8V minimum TI require at the Q201 collector. CLEARS THE HARD SHORT ONLY: if the LTC3639 high side switch fails short the loop is R601 4R7 + L601 1.65R DCR + this fuse + the top and bottom tap fuses, about 8 Ohm, so 6.7A at 16S and this opens in roughly 640us. It can NOT clear a mis-regulation fault - the LTC3639 current limits at 100mA, which is 20% of rating and never opens a fuse. D601 covers that case")
			(fields
				(field
					(name "MPN") "0470.500DRSNP")
				(field
					(name "digikey_pn") "F6622CT-ND")
				(field
					(name "MPN_alt")
				)
				(field
					(name "digikey_pn_alt")
				)
				(field
					(name "Footprint") "custom_footprints:Littelfuse_470-Series_Fuse_1206")
				(field
					(name "Datasheet") "https://www.littelfuse.com/products/fuses-overcurrent-protection/fuses/surface-mount-fuses/thin-film-chip-fuses/470")
				(field
					(name "Description") "FUSE 500mA 125VAC/125VDC fast acting, Littelfuse 470 Series thin-film chip fuse 1206, 0.5455 Ohm cold resistance, 0.0287 A2s nominal melting I2t, interrupting 50A at 125VDC, -55 to +125C, epoxy resin body with Cu/Ni/Sn terminations, Pb-free and halogen-free - 8V8 rail fuse, same part as the 51 cell tap fuses. Carries only the BQ79616 LDOIN supply: 11.6mA IACT(IDLE) max, about 25mA with daisy-chain broadcast, ADC, balancing and open-wire test all active, 20mA startup inrush - 5% of nameplate, so no wear-out concern. Drops 14mV at 25mA against the 800mV budget between the 8.80V rail and the 8V minimum TI require at the Q201 collector. CLEARS THE HARD SHORT ONLY: if the LTC3639 high side switch fails short the loop is R601 4R7 + L601 1.65R DCR + this fuse + the top and bottom tap fuses, about 8 Ohm, so 6.7A at 16S and this opens in roughly 640us. It can NOT clear a mis-regulation fault - the LTC3639 current limits at 100mA, which is 20% of rating and never opens a fuse. D601 covers that case")
			)
