		(comp
			(ref "C601")
			(value "4.7uF 100V X7S")
			(footprint "Capacitor_SMD:C_1210_3225Metric")
			(datasheet "https://www.murata.com/en-global/products/productdetail?partno=GCM32DC72A475KE02%23")
			(description "CAP 4.7uF 100V X7S 1210 AEC-Q200 -55 to +125C - buck output, one of the C601 || C602 pair. TWO 1210 IN PARALLEL RATHER THAN ONE 2220: this cap sits UPSTREAM of F601 and so is not protected by it - if the LTC3639 high side switch fails short, F601 opens and leaves this node at the full pack voltage continuously, fed through R601 and L601, which is 67V at 16S. A cracked MLCC fails SHORT and would then put the pack across L601, the exact failure this part exists to prevent, so flex-crack resistance matters more here than board area and a 2220 is the most crack-prone package there is. 100V also almost eliminates DC bias loss at 8.8V, where the previous 25V 1206 part lost roughly half its capacitance. Pair gives 9.4uF nominal, about 8.9uF at 8.8V bias and roughly 6.3uF at the -10% tolerance and -22% X7S temperature corner, against the 7.5uF from the LTC3639 single-cycle step equation COUT > (L/2)(IPEAK/VOUT)^2 x 100 at the 230mA IPEAK that ISET floating gives; the corner case only widens that step from 1.0% to 1.2% of VOUT, which the 800mV VCollector headroom absorbs. MPN_ALT is the TDK CGA equivalent, which was out of stock when this was chosen")
			(fields
				(field
					(name "MPN") "GCM32DC72A475KE02L")
				(field
					(name "digikey_pn") "490-14484-1-ND")
				(field
					(name "MPN_alt") "CGA6M3X7S2A475K200AB")
				(field
					(name "digikey_pn_alt") "445-7005-1-ND")
				(field
					(name "Footprint") "Capacitor_SMD:C_1210_3225Metric")
				(field
					(name "Datasheet") "https://www.murata.com/en-global/products/productdetail?partno=GCM32DC72A475KE02%23")
				(field
					(name "Description") "CAP 4.7uF 100V X7S 1210 AEC-Q200 -55 to +125C - buck output, one of the C601 || C602 pair. TWO 1210 IN PARALLEL RATHER THAN ONE 2220: this cap sits UPSTREAM of F601 and so is not protected by it - if the LTC3639 high side switch fails short, F601 opens and leaves this node at the full pack voltage continuously, fed through R601 and L601, which is 67V at 16S. A cracked MLCC fails SHORT and would then put the pack across L601, the exact failure this part exists to prevent, so flex-crack resistance matters more here than board area and a 2220 is the most crack-prone package there is. 100V also almost eliminates DC bias loss at 8.8V, where the previous 25V 1206 part lost roughly half its capacitance. Pair gives 9.4uF nominal, about 8.9uF at 8.8V bias and roughly 6.3uF at the -10% tolerance and -22% X7S temperature corner, against the 7.5uF from the LTC3639 single-cycle step equation COUT > (L/2)(IPEAK/VOUT)^2 x 100 at the 230mA IPEAK that ISET floating gives; the corner case only widens that step from 1.0% to 1.2% of VOUT, which the 800mV VCollector headroom absorbs. MPN_ALT is the TDK CGA equivalent, which was out of stock when this was chosen")
			)
