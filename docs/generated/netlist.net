		(comp
			(ref "F401")
			(value "500mA 125V FF")
			(footprint "custom_footprints:Littelfuse_470-Series_Fuse_1206")
			(datasheet "https://www.littelfuse.com/products/fuses-overcurrent-protection/fuses/surface-mount-fuses/thin-film-chip-fuses/470")
			(description "FUSE 500mA 125VAC/125VDC fast acting, Littelfuse 470 Series thin-film chip fuse 1206, 0.5455 Ohm cold resistance, 0.0287 A2s nominal melting I2t, interrupting 50A at 125VDC, -55 to +125C, epoxy resin body with Cu/Ni/Sn terminations, Pb-free and halogen-free, body 3.302 x 1.575 x 1.168mm - cell tap protection; one fuse per connector pin, star connected between each tap connector and the shared VC/CB node, so every connector sees exactly one fuse. Continuous duty is 105mA balance current on the middle taps and up to 180mA on the top and bottom taps, which also carry the whole board supply, so worst case is 36% of rating at 6S low state of charge. The +125C rating matches the Datamate connectors and the BQ79616, unlike the +90C Schurter USF. Uses the Littelfuse recommended land (1.185 x 2.05mm pads on a 1.28mm gap), which is NOT the Schurter 1206 land - the two are not drop-in interchangeable")
			(fields
				(field
					(name "MPN") "0470.500DRSNP")
				(field
					(name "digikey_pn") "F6622CT-ND")
				(field
					(name "MPN_alt")
				)
				(field
					(name "digikey_pn_alt")
				)
				(field
					(name "Footprint") "custom_footprints:Littelfuse_470-Series_Fuse_1206")
				(field
					(name "Datasheet") "https://www.littelfuse.com/products/fuses-overcurrent-protection/fuses/surface-mount-fuses/thin-film-chip-fuses/470")
				(field
					(name "Description") "FUSE 500mA 125VAC/125VDC fast acting, Littelfuse 470 Series thin-film chip fuse 1206, 0.5455 Ohm cold resistance, 0.0287 A2s nominal melting I2t, interrupting 50A at 125VDC, -55 to +125C, epoxy resin body with Cu/Ni/Sn terminations, Pb-free and halogen-free, body 3.302 x 1.575 x 1.168mm - cell tap protection; one fuse per connector pin, star connected between each tap connector and the shared VC/CB node, so every connector sees exactly one fuse. Continuous duty is 105mA balance current on the middle taps and up to 180mA on the top and bottom taps, which also carry the whole board supply, so worst case is 36% of rating at 6S low state of charge. The +125C rating matches the Datamate connectors and the BQ79616, unlike the +90C Schurter USF. Uses the Littelfuse recommended land (1.185 x 2.05mm pads on a 1.28mm gap), which is NOT the Schurter 1206 land - the two are not drop-in interchangeable")
			)
