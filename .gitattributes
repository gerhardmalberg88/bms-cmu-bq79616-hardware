* text=auto eol=lf

*.kicad_pro text eol=lf
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

*.pdf binary
*.png binary
*.zip binary
*.step binary
*.stp binary
*.STEP binary
*.STP binary
*.FCStd binary

# Manufacturing checksums cover exact bytes; do not normalize release files.
manufacturing/** -text
# IPC-D-356 records intentionally contain fixed-width trailing padding.
manufacturing/**/fabrication/*.d356 whitespace=-blank-at-eol
manufacturing/**/verification/ipc-native-export.txt whitespace=-blank-at-eol
# Preserve the native FreeCAD banner, including its final blank line.
manufacturing/**/verification/freecad-readback.log whitespace=-blank-at-eof
*.stl binary
*.xlsx binary
